 "queries": {
  "beacon-health-failed-notifications-query": {
   "folder": null,
   "is_builder_query": 0,
   "is_native_query": 1,
   "is_script_query": 0,
   "name": "beacon-health-failed-notifications-query",
   "operations": [
    {
     "data_source": "Site DB",
     "raw_sql": "SELECT DATE(creation) AS day, channel, COUNT(*) AS notifications\nFROM `tabBeacon Notification`\nWHERE status = 'Failed' AND creation >= CURDATE() - INTERVAL 30 DAY\nGROUP BY day, channel\n",
     "type": "sql"
    }
   ],
   "sort_order": 2,
   "title": "Failed notifications by day",
   "use_live_connection": 1,
   "workbook": "beacon-health"
  },
  "beacon-health-noisiest-rules-query": {
   "folder": null,
   "is_builder_query": 0,
   "is_native_query": 1,
   "is_script_query": 0,
   "name": "beacon-health-noisiest-rules-query",
   "operations": [
    {
     "data_source": "Site DB",
     "raw_sql": "SELECT alert.rule, alert.severity, COUNT(*) AS alerts\nFROM `tabBeacon Alert` AS alert\nJOIN (\n  SELECT rule FROM `tabBeacon Alert` WHERE creation >= NOW() - INTERVAL 30 DAY\n  GROUP BY rule ORDER BY COUNT(*) DESC LIMIT 10\n) AS top ON top.rule = alert.rule\nWHERE alert.creation >= NOW() - INTERVAL 30 DAY\nGROUP BY alert.rule, alert.severity\n",
     "type": "sql"
    }
   ],
   "sort_order": 3,
   "title": "Alerts by rule",
   "use_live_connection": 1,
   "workbook": "beacon-health"
  },
  "beacon-health-notification-delay-query": {
   "folder": null,
   "is_builder_query": 0,
   "is_native_query": 1,
   "is_script_query": 0,
   "name": "beacon-health-notification-delay-query",
   "operations": [
    {
     "data_source": "Site DB",
     "raw_sql": "SELECT DATE(creation) AS day, channel, AVG(TIMESTAMPDIFF(SECOND, creation, sent_at)) AS delay_seconds\nFROM `tabBeacon Notification`\nWHERE sent_at IS NOT NULL AND creation >= CURDATE() - INTERVAL 30 DAY\nGROUP BY day, channel\n",
     "type": "sql"
    }
   ],
   "sort_order": 1,
   "title": "Notification delay by day",
   "use_live_connection": 1,
   "workbook": "beacon-health"
  },
  "beacon-health-slo-by-day-query": {
   "folder": null,
   "is_builder_query": 0,
   "is_native_query": 1,
   "is_script_query": 0,
   "name": "beacon-health-slo-by-day-query",
   "operations": [
    {
     "data_source": "Site DB",
     "raw_sql": "SELECT DATE(m.minute) AS date, service.title AS service, 100 * SUM(m.good) / SUM(m.valid) AS sli\nFROM `tabBeacon Service Minute` AS m\nJOIN `tabBeacon Alert Rule` AS service ON service.name = m.service\nWHERE service.kind = 'SLO Burn' AND m.minute >= CURDATE() - INTERVAL 30 DAY AND m.valid > 0\nGROUP BY DATE(m.minute), service.name, service.title\n",
     "type": "sql"
    }
   ],
   "sort_order": 4,
   "title": "SLI by service and day",
   "use_live_connection": 1,
   "workbook": "beacon-health"
  },
  "beacon-health-slo-by-service-query": {
   "folder": null,
   "is_builder_query": 0,
   "is_native_query": 1,
   "is_script_query": 0,
   "name": "beacon-health-slo-by-service-query",
   "operations": [
    {
     "data_source": "Site DB",
     "raw_sql": "SELECT service.title AS service, service.slo_target,\n  100 * SUM(m.good) / NULLIF(SUM(m.valid), 0) AS sli,\n  SUM(m.status = 'Degraded') AS degraded_minutes,\n  SUM(m.status IN ('Partial Outage', 'Major Outage')) AS outage_minutes\nFROM `tabBeacon Service Minute` AS m\nJOIN `tabBeacon Alert Rule` AS service ON service.name = m.service\nWHERE service.kind = 'SLO Burn' AND m.minute >= CURDATE() - INTERVAL 30 DAY\nGROUP BY service.name, service.title, service.slo_target\nORDER BY sli\n",
     "type": "sql"
    }
   ],
   "sort_order": 5,
   "title": "SLI by service",
   "use_live_connection": 1,
   "workbook": "beacon-health"
  },
  "beacon-health-summary-query": {
   "folder": null,
   "is_builder_query": 0,
   "is_native_query": 1,
   "is_script_query": 0,
   "name": "beacon-health-summary-query",
   "operations": [
    {
     "data_source": "Site DB",
     "raw_sql": "SELECT\n  (SELECT COUNT(*) FROM `tabBeacon Incident`\n    WHERE type = 'Incident' AND status != 'Merged' AND creation >= NOW() - INTERVAL 30 DAY) AS incidents,\n  (SELECT 100 * SUM(detected_by = 'Customer') / COUNT(*) FROM `tabBeacon Incident`\n    WHERE type = 'Incident' AND status != 'Merged' AND creation >= NOW() - INTERVAL 30 DAY) AS found_by_customers,\n  (SELECT AVG(TIMESTAMPDIFF(SECOND, creation, acknowledged_at)) / 60 FROM `tabBeacon Incident`\n    WHERE type = 'Incident' AND acknowledged_at IS NOT NULL AND creation >= NOW() - INTERVAL 30 DAY) AS minutes_to_acknowledge,\n  (SELECT AVG(TIMESTAMPDIFF(SECOND, creation, resolved_at)) / 60 FROM `tabBeacon Incident`\n    WHERE type = 'Incident' AND status = 'Resolved' AND creation >= NOW() - INTERVAL 30 DAY) AS minutes_to_resolve,\n  (SELECT COUNT(*) FROM `tabBeacon Notification`\n    WHERE status = 'Failed' AND creation >= NOW() - INTERVAL 30 DAY) AS failed_notifications\n",
     "type": "sql"
    }
   ],
   "sort_order": 0,
   "title": "Last 30 days",
   "use_live_connection": 1,
   "workbook": "beacon-health"
  }
 },
